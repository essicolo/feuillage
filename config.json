{
  "view": {
    "name": "Atlas hydroclimatique",
    "description": "Tronçons PMTiles, stations GeoJSON ; fiches et indicateurs lus par range requests dans des parquet statiques (hyparquet), débits observés aux stations et portrait RQH en zarr",
    "center": [47.2, -71.5],
    "zoom": 6,
    "basemap": "osm"
  },
  "layers": [
    {
      "name": "Tronçons de l'Atlas",
      "url": "./data/rqh/troncons.pmtiles",
      "type": "pmtiles",
      "source_layer": "troncons",
      "geometry_type": "line",
      "visible": true,
      "color": "#095797",
      "popup_template": "troncon_atlas",
      "attribution": "<a href=\"https://www.donneesquebec.ca/recherche/dataset/atlas-hydroclimatique-2022\">Atlas hydroclimatique 2022, MELCCFP</a> (<a href=\"https://creativecommons.org/licenses/by/4.0/deed.fr\">CC BY 4.0</a>, formats convertis)",
      "color_by": {
        "label": "Colorer par indicateur",
        "none_label": "Aucun (couleur unie)",
        "url": "./data/atlas/indicateurs_carte.parquet",
        "key": { "column": "troncon_id", "property": "IDTRONCON" },
        "column": "{indicateur}__amp_{horizon}_{scenario}",
        "missing_color": "#D3D7DD",
        "missing_label": "Indicateurs non publiés",
        "scale": "ampleur",
        "scales": {
          "ampleur": {
            "label": "Ampleur du changement",
            "unit": "%",
            "stops": [
              [-50, "#543005"], [-20, "#8C510A"], [-5, "#BF812D"], [0, "#7F7F7F"],
              [5, "#35978F"], [20, "#01665E"], [50, "#003C30"]
            ],
            "ticks": [-50, -20, 0, 20, 50]
          },
          "jours": {
            "label": "Devancement (−) ou retard (+)",
            "unit": " j",
            "stops": [
              [-30, "#40004B"], [-15, "#762A83"], [-5, "#9970AB"], [0, "#7F7F7F"],
              [5, "#5AAE61"], [15, "#1B7837"], [30, "#00441B"]
            ],
            "ticks": [-30, -15, 0, 15, 30]
          }
        },
        "dimensions": [
          {
            "name": "indicateur",
            "label": "Indicateur",
            "options": [
              { "label": "Débit moyen", "options": [
                { "value": "QMOYAN", "label": "Annuel" },
                { "value": "QMOYHP", "label": "Hiver-printemps" },
                { "value": "QMOYEA", "label": "Été-automne" },
