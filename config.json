                { "value": "Q14MAX100HP", "label": "100 ans, hiver-printemps" },
                { "value": "Q14MAX350HP", "label": "350 ans, hiver-printemps" }
              ] },
              { "label": "Étiage : débit minimal sur 7 jours (Q7min)", "options": [
                { "value": "Q7MIN2AN", "label": "2 ans, annuel" },
                { "value": "Q7MIN5AN", "label": "5 ans, annuel" },
                { "value": "Q7MIN10AN", "label": "10 ans, annuel" },
                { "value": "Q7MIN2HP", "label": "2 ans, hiver-printemps" },
                { "value": "Q7MIN5HP", "label": "5 ans, hiver-printemps" },
                { "value": "Q7MIN10HP", "label": "10 ans, hiver-printemps" },
                { "value": "Q7MIN2EA", "label": "2 ans, été-automne" },
                { "value": "Q7MIN5EA", "label": "5 ans, été-automne" },
