                { "value": "Q7MIN2_06", "label": "2 ans, juin" },
                { "value": "Q7MIN2_07", "label": "2 ans, juillet" },
                { "value": "Q7MIN2_08", "label": "2 ans, août" },
                { "value": "Q7MIN2_09", "label": "2 ans, septembre" },
                { "value": "Q7MIN2_10", "label": "2 ans, octobre" },
                { "value": "Q7MIN2_11", "label": "2 ans, novembre" },
                { "value": "Q7MIN2_12", "label": "2 ans, décembre" }
