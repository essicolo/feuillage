                { "value": "Q1MAX10HP", "label": "10 ans, hiver-printemps" },
                { "value": "Q1MAX20HP", "label": "20 ans, hiver-printemps" },
                { "value": "Q1MAX100HP", "label": "100 ans, hiver-printemps" },
                { "value": "Q1MAX350HP", "label": "350 ans, hiver-printemps" },
                { "value": "Q1MAX2EA", "label": "2 ans, été-automne" },
